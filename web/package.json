{
  "name": "rtp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pitch Rehab demo front end. Runs MediaPipe live in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cert": "node scripts/make-cert.mjs",
    "phone": "node scripts/phone.mjs",
    "apk": "node scripts/build-apk.mjs",
    "apk:send": "node scripts/serve-apk.mjs",
    "deploy": "node scripts/deploy.mjs",
    "assets": "node scripts/vendor-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@mediapipe/tasks-vision": "^1.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
