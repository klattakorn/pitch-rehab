{
  "name": "rtp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pitch Rehab demo front end. Runs MediaPipe live in the browser.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-snapshot.mjs && node scripts/vendor-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cert": "node scripts/make-cert.mjs",
    "phone": "node scripts/phone.mjs",
    "deploy": "node scripts/deploy.mjs",
    "assets": "node scripts/vendor-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.187.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
