# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- local settings, copied from .env.example and edited ---
.env
.env.*
!.env.example

# --- the database (each person keeps their own; reseed with scripts/) ---
rtp.db
rtp.db-shm
rtp.db-wal
*.sqlite3

# --- node ---
web/node_modules/
web/dist/
web/.vite/

# --- generated: run `node scripts/vendor-assets.mjs` inside web/ to rebuild ---
# (both are copies of files already tracked under models/ and node_modules)
web/public/mediapipe/
web/public/models/

# --- test footage lives in the shared Drive folder, not in git (too big) ---
# Ignore the *contents*, not the folder: git cannot un-ignore a file inside an
# ignored directory, and videos/README.md is the filming brief everyone needs.
videos/*
!videos/README.md
*.mp4
*.mov
*.m4v
*.avi
*.mkv

# The exception: the shrunk clips the app itself plays on its "how to" screen.
# These are a couple of megabytes each rather than thirty, and the hosted site
# 404s without them -- so unlike the raw footage, they have to be in git.
!web/public/demos/*.mp4

# --- dev https certificate (machine-specific; regenerate with make-cert.mjs) ---
web/.cert/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Whatever a host's CLI leaves behind if anyone ever runs one. Publishing is a
# push now -- Cloudflare Pages builds the repository -- so nothing here is part
# of deploying; these are machine-local leftovers either way.
web/.cloudflare-account
web/.netlify/
