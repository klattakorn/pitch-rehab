# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- the database (each person keeps their own; reseed with scripts/) ---
rtp.db
rtp.db-shm
rtp.db-wal
*.sqlite3

# --- node ---
web/node_modules/
web/dist/
web/.vite/

# --- generated: run `node scripts/vendor-assets.mjs` inside web/ to rebuild ---
# (both are copies of files already tracked under models/ and node_modules)
web/public/mediapipe/
web/public/models/

# --- test footage lives in the shared Drive folder, not in git (too big) ---
# Ignore the *contents*, not the folder: git cannot un-ignore a file inside an
# ignored directory, and videos/README.md is the filming brief everyone needs.
videos/*
!videos/README.md
*.mp4
*.mov
*.m4v
*.avi
*.mkv

# --- dev https certificate (machine-specific; regenerate with make-cert.mjs) ---
web/.cert/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Android (Capacitor) ---
# The android/ project itself IS tracked: it carries the manifest, the icons
# and MainActivity, which are real source. Only what Gradle makes is ignored.
web/android/build/
web/android/app/build/
web/android/.gradle/
web/android/local.properties
web/android/app/src/main/assets/public/
web/android/app/src/main/assets/capacitor.config.json
web/android/capacitor-cordova-android-plugins/
*.apk
*.aab

# Generated from scripts/make_app_icon.py, then fanned out by capacitor-assets.
web/assets/

# Which Cloudflare account `npm run deploy` publishes to. Not a secret -- it is
# in every dashboard URL and is useless without a token -- but it belongs to
# whoever is deploying, so each person sets their own.
web/.cloudflare-account

# Netlify CLI's record of which site this folder deploys to. Machine-local.
web/.netlify/
