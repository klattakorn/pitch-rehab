# Copy to .env and edit.
RTP_ENV=dev
RTP_DATABASE_URL=sqlite:///./rtp.db
# For Postgres: postgresql+psycopg://rtp:rtp@localhost:5432/rtp

# CHANGE THIS IN PRODUCTION. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
RTP_SECRET_KEY=dev-only-insecure-change-me
RTP_ACCESS_TOKEN_TTL_MINUTES=43200

RTP_SEED_ON_STARTUP=true
RTP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","capacitor://localhost"]

# Max landmark frames accepted in one set upload (~2 min at 30fps)
RTP_MAX_FRAMES_PER_UPLOAD=3600
